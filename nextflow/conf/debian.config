// conf/debian.config — Servidor Debian com 64 cores, 256 GB RAM
// Ajuste max_cpus e max_memory conforme seu servidor

params {
    config_profile_name        = 'Debian server'
    config_profile_description = 'Local Debian 12 with 64 cores, 256GB RAM'
    max_cpus    = 64
    max_memory  = '256.GB'
    max_time    = '120.h'
}

process {
    executor    = 'local'

    withLabel:process_low    { cpus = 4;  memory = '16.GB';  time = '4.h'  }
    withLabel:process_medium { cpus = 16; memory = '64.GB';  time = '24.h' }
    withLabel:process_high   { cpus = 32; memory = '128.GB'; time = '72.h' }
    withLabel:process_gpu    {
        cpus   = 16
        memory = '128.GB'
        time   = '96.h'
    }
}
