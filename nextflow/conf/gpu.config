// conf/gpu.config — Adicionar GPU para AlphaFold3 (fase 7) e GROMACS (fase 10)
// Combinar com debian: -profile debian,gpu

params {
    use_gpu = true
}

process {
    withLabel:process_gpu {
        cpus        = 16
        memory      = '64.GB'
        time        = '96.h'
        // Para RTX 5070 Ti ou similar
        // Ajuste o device_id se tiver múltiplas GPUs
        containerOptions = '--nv'  // para Apptainer/Singularity
    }
}

// Configurar GROMACS para GPU
env {
    GMX_GPU_DD_COMMS        = "true"
    GMX_GPU_PME_PP_COMMS    = "true"
    GMX_FORCE_UPDATE_DEFAULT_GPU = "true"
}
