// conf/test.config — Perfil de teste com dataset mínimo (stub-run)
params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset — use with -stub-run'

    input_fasta    = "${projectDir}/../../tests/data/test_assembly.fasta"
    outdir         = "${projectDir}/../../results_test"
    max_cpus       = 2
    max_memory     = '6.GB'
    max_time       = '1.h'

    // Usar referências de teste (menores)
    uniprot_db     = "${projectDir}/../../tests/data/test_sprot.dmnd"
    pfam_db        = "${projectDir}/../../tests/data/test_Pfam-A.hmm"
    busco_lineage  = "${projectDir}/../../tests/data/insecta_odb10_mini"
}

process {
    withLabel:process_low    { cpus = 1; memory = '2.GB'; time = '30.m' }
    withLabel:process_medium { cpus = 2; memory = '4.GB'; time = '1.h'  }
    withLabel:process_high   { cpus = 2; memory = '6.GB'; time = '1.h'  }
    withLabel:process_gpu    { cpus = 2; memory = '6.GB'; time = '1.h'  }
}
