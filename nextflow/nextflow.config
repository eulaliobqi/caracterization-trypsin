// nextflow.config — trypsin-agemmatalis-structural
// Projeto: Caracterização estrutural de tripsinas de Anticarsia gemmatalis

nextflow.enable.dsl = 2

manifest {
    name            = 'trypsin-agemmatalis-structural'
    author          = 'Eulálio Gutemberg'
    homePage        = 'https://github.com/eulaliobqi/trypsin-agemmatalis-structural'
    description     = 'Structural characterization of Anticarsia gemmatalis trypsins'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
}

// ── Parâmetros principais ──────────────────────────────────────────────────
params {
    // Inputs
    input_fasta           = "${projectDir}/../data/raw/trinity_assembly.fasta"
    outdir                = "${projectDir}/../results"

    // Referências (baixar separadamente — ver README.md)
    uniprot_db            = "${projectDir}/../data/references/uniprot_sprot.dmnd"
    pfam_db               = "${projectDir}/../data/references/Pfam-A.hmm"
    busco_lineage         = "${projectDir}/../data/references/insecta_odb10"
    lep_refs              = "${projectDir}/../data/references/trypsin_refs_lepidoptera.fasta"
    bovine_trypsin_ref    = "${projectDir}/../data/references/bovine_trypsin_1TGN.fasta"

    // AlphaFold3 (caminhos no servidor)
    alphafold3_models     = "/data/alphafold3/models"
    alphafold3_db         = "/data/alphafold3/databases"

    // Parâmetros de qualidade
    diamond_evalue        = 1e-10
    hmmer_evalue          = 1e-10
    min_aa_length         = 220
    blast_coverage        = 0.80
    blast_identity        = 30
    pfam_coverage         = 0.80
    cdhit_identity        = 0.95     // para CD-HIT-EST na Fase 1
    af3_num_recycles      = 10
    md_duration_ns        = 100      // duração das simulações MD

    // Inibidores de docking
    inhibitors_fasta      = "${projectDir}/../data/references/inhibitors_skti_bpti.fasta"

    // Controle de fases (null = executar todas)
    phase                 = null

    // Compute defaults
    max_cpus              = 32
    max_memory            = '128.GB'
    max_time              = '72.h'
    use_gpu               = false

    // Misc
    publish_dir_mode      = 'copy'
    monochrome_logs       = false
    help                  = false
}

// ── Perfis de execução ────────────────────────────────────────────────────
profiles {
    test    { includeConfig 'conf/test.config' }
    debian  { includeConfig 'conf/debian.config' }
    gpu     { includeConfig 'conf/gpu.config' }
    base    { includeConfig 'conf/base.config' }
}

// ── Conda / Mamba ─────────────────────────────────────────────────────────
conda {
    enabled    = true
    useMamba   = true
    cacheDir   = "${HOME}/.conda/envs"
}

// ── Recursos padrão de processos ──────────────────────────────────────────
process {
    // Nextflow 26.x: def funcName() {} não é mais válido em config files.
    // Usar Math.min() inline para CPUs; memory/time com crescimento por attempt.
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143] ?
                      'retry' : 'finish' }
    maxRetries    = 2

    withLabel:process_low {
        cpus   = { Math.min(2  * task.attempt, params.max_cpus as int) }
        memory = { 8.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { Math.min(8  * task.attempt, params.max_cpus as int) }
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withLabel:process_high {
        cpus   = { Math.min(16 * task.attempt, params.max_cpus as int) }
        memory = { 64.GB * task.attempt }
        time   = { 48.h  * task.attempt }
    }
    withLabel:process_gpu {
        cpus   = 16
        memory = '64.GB'
        time   = '72.h'
    }
}

// ── Tracing e relatórios ──────────────────────────────────────────────────
// Nextflow 26.x: def variável não é suportado em config; usar string fixa
// para o timestamp (os reports são sobrescritos a cada run via overwrite=true)
timeline {
    enabled  = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled  = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled  = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled  = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}
