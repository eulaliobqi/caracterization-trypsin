// nextflow.config — trypsin-agemmatalis-structural
// Projeto: Caracterização estrutural de tripsinas de Anticarsia gemmatalis

nextflow.enable.dsl = 2

manifest {
    name            = 'trypsin-agemmatalis-structural'
    author          = 'Eulálio Gutemberg'
    homePage        = 'https://github.com/eulaliobqi/trypsin-agemmatalis-structural'
    description     = 'Structural characterization of Anticarsia gemmatalis trypsins'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
}

// ── Parâmetros principais ──────────────────────────────────────────────────
params {
    // Inputs
    input_fasta           = "${projectDir}/../data/raw/trinity_assembly.fasta"
    outdir                = "${projectDir}/../results"

    // Referências (baixar separadamente — ver README.md)
    uniprot_db            = "${projectDir}/../data/references/uniprot_sprot.dmnd"
    pfam_db               = "${projectDir}/../data/references/Pfam-A.hmm"
    busco_lineage         = "${projectDir}/../data/references/insecta_odb10"
    lep_refs              = "${projectDir}/../data/references/trypsin_refs_lepidoptera.fasta"
    bovine_trypsin_ref    = "${projectDir}/../data/references/bovine_trypsin_1TGN.fasta"

    // AlphaFold3 (caminhos no servidor)
    alphafold3_models     = "/data/alphafold3/models"
    alphafold3_db         = "/data/alphafold3/databases"

    // Parâmetros de qualidade
    diamond_evalue        = 1e-10
    hmmer_evalue          = 1e-10
    min_aa_length         = 220
    blast_coverage        = 0.80
    blast_identity        = 30
    pfam_coverage         = 0.80
    cdhit_identity        = 0.95     // para CD-HIT-EST na Fase 1
    af3_num_recycles      = 10
    md_duration_ns        = 100      // duração das simulações MD

    // Inibidores de docking
    inhibitors_fasta      = "${projectDir}/../data/references/inhibitors_skti_bpti.fasta"

    // Controle de fases (null = executar todas)
    phase                 = null

    // Compute defaults
    max_cpus              = 32
    max_memory            = '128.GB'
    max_time              = '72.h'
    use_gpu               = false

    // Misc
    publish_dir_mode      = 'copy'
    monochrome_logs       = false
    help                  = false
}

// ── Perfis de execução ────────────────────────────────────────────────────
profiles {
    test    { includeConfig 'conf/test.config' }
    debian  { includeConfig 'conf/debian.config' }
    gpu     { includeConfig 'conf/gpu.config' }
    base    { includeConfig 'conf/base.config' }
}

// ── Conda / Mamba ─────────────────────────────────────────────────────────
conda {
    enabled    = true
    useMamba   = true
    cacheDir   = "${HOME}/.conda/envs"
}

// ── Recursos padrão de processos ──────────────────────────────────────────
process {
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143] ?
                      'retry' : 'finish' }
    maxRetries    = 2

    withLabel:process_low {
        cpus   = { check_max(2  * task.attempt, 'cpus') }
        memory = { check_max(8.GB  * task.attempt, 'memory') }
        time   = { check_max(2.h   * task.attempt, 'time') }
    }
    withLabel:process_medium {
        cpus   = { check_max(8  * task.attempt, 'cpus') }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(12.h  * task.attempt, 'time') }
    }
    withLabel:process_high {
        cpus   = { check_max(16 * task.attempt, 'cpus') }
        memory = { check_max(64.GB * task.attempt, 'memory') }
        time   = { check_max(48.h  * task.attempt, 'time') }
    }
    withLabel:process_gpu {
        cpus   = { check_max(16, 'cpus') }
        memory = { check_max(64.GB, 'memory') }
        time   = { check_max(72.h, 'time') }
    }
}

// ── Tracing e relatórios ──────────────────────────────────────────────────
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.svg"
}

// ── Função check_max ──────────────────────────────────────────────────────
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj as int, params.max_cpus as int) }
        catch (all) { return obj }
    }
}
